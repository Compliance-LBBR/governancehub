name: Manter Supabase ativo

# Ping leve a cada 2 dias para evitar a pausa automatica do plano gratuito.
# O banco guarda as confirmacoes de leitura (evidencia de compliance) e o
# contador de visualizacoes do Governance Hub, e nao pode hibernar.
# A chave abaixo e a anon key publica, a mesma ja exposta no index.html do portal.

on:
  schedule:
    - cron: "0 9 */2 * *"
  workflow_dispatch: {}

jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - name: Ping ao Supabase
        run: |
          codigo=$(curl -s -o /dev/null -w "%{http_code}" \
            -H "apikey: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRlZWdjZHB5bG1mbnplYnVybmhiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODExMTMyMzYsImV4cCI6MjA5NjY4OTIzNn0.qxZk7jZWO-5og94Dj_r39NgVifQHxJhkpbtfqIevx-g" \
            "https://deegcdpylmfnzeburnhb.supabase.co/rest/v1/?select=" )
          echo "Resposta do Supabase: HTTP $codigo"
          if [ "$codigo" -ge 500 ] || [ "$codigo" -eq 000 ]; then
            echo "Supabase inacessivel (possivelmente pausado). Verificar o painel."
            exit 1
          fi
